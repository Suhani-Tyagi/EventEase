# EventEase Configuration
# Copy this file to .env and adjust as needed

# Gemini API Key (leave blank to run in offline fallback mode)
GEMINI_API_KEY=

# Server Environment: development | production | test
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Local SQLite is suitable for development only. Use PostgreSQL on Vercel.
DATABASE_URL=sqlite:///./eventease.db
SESSION_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Security & Limits
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=20
MAX_REQUEST_BODY_BYTES=1048576

# LLM Settings
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_RETRIES=2
CACHE_TTL_SECONDS=3600
